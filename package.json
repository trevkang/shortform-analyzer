{
  "name": "shortform-analyzer",
  "version": "0.4.1",
  "description": "One fixed record per short-form video (TikTok, Reels, Shorts): topic, format, what it sells, tags, and per scene its role (hook, body, payoff, cta), footage, words and text on screen; for a post that sells or asks, a kind for each top comment. A library, a CLI, an MCP server and an agent skill.",
  "license": "MIT",
  "author": "trevkang",
  "homepage": "https://github.com/trevkang/shortform-analyzer#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trevkang/shortform-analyzer.git"
  },
  "bugs": "https://github.com/trevkang/shortform-analyzer/issues",
  "keywords": [
    "video",
    "short-form",
    "tiktok",
    "reels",
    "shorts",
    "scene-detection",
    "subtitles",
    "comments",
    "openai",
    "apinoa",
    "mcp",
    "agent-skill",
    "ffmpeg"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./primitives": {
      "types": "./dist/primitives.d.ts",
      "default": "./dist/primitives.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "shortform-analyzer": "dist/cli.js"
  },
  "files": [
    "dist",
    "schema",
    "skills"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && chmod +x dist/cli.js",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && vitest run",
    "test:consumer": "bash tests/consumer/run.sh",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@apinoa/sdk": "^0.1.2",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "ajv": "^8.17.1",
    "typescript": "~5.7.3",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@12.14.0",
  "contributors": [
    {
      "name": "Trevor",
      "url": "https://github.com/trevkang"
    },
    {
      "name": "Viktor",
      "url": "https://github.com/Reblexis"
    }
  ]
}
