{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/trevkang/shortform-analyzer/schema/analysis.schema.json",
  "title": "Analysis",
  "description": "What shortform-analyzer's analyzeVideo returns (schemaVersion 2): the record of docs/video-analysis.md plus how it was made.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "ok",
    "media",
    "duration",
    "speech",
    "topic",
    "format",
    "sells",
    "asksForComment",
    "product",
    "tags",
    "description",
    "formatDescription",
    "scenes",
    "stages",
    "costUsd",
    "raw"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "ok": {
      "const": true
    },
    "media": {
      "type": "string",
      "enum": [
        "video",
        "photos"
      ]
    },
    "duration": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "speech": {
      "type": "string",
      "enum": [
        "subtitles",
        "transcription",
        "none"
      ]
    },
    "topic": {
      "type": "string",
      "enum": [
        "beauty",
        "fashion",
        "gaming",
        "tech",
        "education",
        "business_money",
        "entertainment",
        "music_dance",
        "food",
        "fitness_sports",
        "shopping",
        "lifestyle",
        "other"
      ]
    },
    "format": {
      "type": "string",
      "enum": [
        "tutorial",
        "listicle",
        "before_after",
        "review",
        "storytime",
        "skit",
        "performance",
        "reaction",
        "highlight",
        "interview",
        "vlog",
        "talking_head",
        "other"
      ]
    },
    "sells": {
      "type": "string",
      "enum": [
        "none",
        "software",
        "physical_goods",
        "service",
        "digital_content",
        "other"
      ]
    },
    "asksForComment": {
      "type": "boolean"
    },
    "product": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "string",
        "pattern": "^[\\p{L}\\p{N}]+$"
      }
    },
    "description": {
      "type": "string"
    },
    "formatDescription": {
      "type": "string"
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "items": {
        "$ref": "#/definitions/scene"
      }
    },
    "comments": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "$ref": "#/definitions/comment"
      }
    },
    "answers": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "boolean",
          "string"
        ]
      }
    },
    "stages": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {
          "$ref": "#/definitions/stage"
        },
        "scenes": {
          "$ref": "#/definitions/stage"
        },
        "frames": {
          "$ref": "#/definitions/stage"
        },
        "speech": {
          "$ref": "#/definitions/stage"
        },
        "describe": {
          "$ref": "#/definitions/stage"
        },
        "decide": {
          "$ref": "#/definitions/stage"
        },
        "comments": {
          "$ref": "#/definitions/stage"
        }
      }
    },
    "costUsd": {
      "type": "number",
      "minimum": 0
    },
    "raw": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "post": {},
        "subtitles": {},
        "transcript": {},
        "describe": {},
        "decide": {},
        "comments": {},
        "commentsDecide": {}
      }
    }
  },
  "definitions": {
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "start",
        "end",
        "cut",
        "role",
        "footage",
        "splitScreen",
        "overlay",
        "textBar",
        "captions",
        "message",
        "spoken",
        "onScreenText",
        "frame"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "start": {
          "type": "number",
          "minimum": 0
        },
        "end": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "cut": {
          "type": "boolean"
        },
        "role": {
          "type": "string",
          "enum": [
            "hook",
            "body",
            "payoff",
            "cta"
          ]
        },
        "footage": {
          "type": "string",
          "enum": [
            "camera_face",
            "camera_body",
            "camera_no_person",
            "screen",
            "graphics",
            "other"
          ]
        },
        "showsProduct": {
          "type": "boolean"
        },
        "subject": {
          "type": "string",
          "enum": [
            "face",
            "full_body",
            "people",
            "hands",
            "object",
            "animal",
            "place",
            "slide",
            "interface"
          ]
        },
        "splitScreen": {
          "type": "boolean"
        },
        "overlay": {
          "type": "boolean"
        },
        "textBar": {
          "type": "boolean"
        },
        "captions": {
          "type": "boolean"
        },
        "message": {
          "type": "boolean"
        },
        "spoken": {
          "type": "string"
        },
        "onScreenText": {
          "type": "string"
        },
        "frame": {
          "type": "string",
          "pattern": "^data:image/jpeg;base64,"
        },
        "answers": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "boolean",
              "string"
            ]
          }
        }
      }
    },
    "comment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text",
        "likes",
        "kind"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string"
        },
        "likes": {
          "type": "number",
          "minimum": 0
        },
        "kind": {
          "type": "string",
          "enum": [
            "cta_reply",
            "intent",
            "negative",
            "positive",
            "other"
          ]
        }
      }
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "ms",
        "costUsd"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "ms": {
          "type": "number",
          "minimum": 0
        },
        "costUsd": {
          "type": "number",
          "minimum": 0
        },
        "reused": {
          "const": true
        },
        "requests": {
          "type": "number",
          "minimum": 0
        },
        "inputTokens": {
          "type": "number",
          "minimum": 0
        },
        "outputTokens": {
          "type": "number",
          "minimum": 0
        },
        "images": {
          "type": "number",
          "minimum": 0
        },
        "audioSec": {
          "type": "number",
          "minimum": 0
        },
        "apinoaCalls": {
          "type": "number",
          "minimum": 0
        },
        "video": {
          "type": "string",
          "pattern": "^(tiktok:\\d+|sha256:[0-9a-f]{64})$"
        },
        "error": {
          "type": "string"
        }
      }
    }
  }
}
